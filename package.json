{
  "name": "cafe-1000",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "npm run validate:receipts && next build",
    "start": "node scripts/serve-static.mjs",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test src/lib/receipts.test.ts src/lib/collection.test.ts src/lib/site.test.ts scripts/serve-static.test.mjs",
    "test:e2e": "npm run build && node scripts/run-e2e.mjs",
    "validate:receipts": "node --experimental-strip-types scripts/validate-receipts.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "typescript": "^5"
  }
}
