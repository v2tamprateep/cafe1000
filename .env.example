# Build-time settings only. Neither value may contain secrets.
# Optional repository link shown in the site header.
# CAFE_REPOSITORY_URL=https://github.com/your-team/cafe-1000

# Leave empty for hosting at an origin root; use /cafe-1000 for a project subpath.
# Use the same setting for the build and local static preview.
# CAFE_BASE_PATH=/cafe-1000
